# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=your-key-from-aistudio.google.com
# Optional:
# GEMINI_MODEL=gemini-3.5-flash     # gemini-3.5-flash-lite is faster still
# GEMINI_MIN_INTERVAL=7      # seconds between Gemini calls (default 7, for the free tier)

# research/fetch_data.py only (VOC-ALS dataset): Synapse Settings -> Personal Access Tokens
SYNAPSE_AUTH_TOKEN=your-synapse-token
